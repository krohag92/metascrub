      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(gh pr create:*)",
      "Bash(gh release create:*)",
      "Bash(gh repo delete:*)",
      "WebFetch(domain:*)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/.ssh/**)",
      "Read(**/keystore*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(.env*)",
      "Edit(**/.env*)",
      "Write(.env*)",
      "Write(**/.env*)"
    ]
  },
  "env": {
    "METASCRUB_BRAND_URL": "https://metadatafinder.com",
    "METASCRUB_REPO": "metascrub/metascrub",
    "METASCRUB_LICENSE": "MIT",
    "NODE_NO_WARNINGS": "1"
  },
  "model": "claude-opus-4-7",
  "outputStyle": "default"
}
