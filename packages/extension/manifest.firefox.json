{
  "manifest_version": 3,
  "name": "MetaScrub — Metadata Viewer & Scrubber",
  "version": "0.1.0",
  "description": "View and strip EXIF, GPS, and document metadata from any file. Privacy-first. Powered by metadatafinder.com.",
  "homepage_url": "https://metadatafinder.com",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "MetaScrub",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "scripts": ["src/background.ts"],
    "type": "module"
  },
  "permissions": ["contextMenus", "downloads", "storage"],
  "host_permissions": ["<all_urls>"],
  "options_page": "src/options/index.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "metascrub@metadatafinder.com",
      "strict_min_version": "109.0"
    }
  }
}
