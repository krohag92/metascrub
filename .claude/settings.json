      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git tag:*)",
      "Bash(git config:*)",
      "Bash(gh repo:*)",
      "Bash(gh pr list:*)",
