{
  "name": "@metascrub/core",
  "version": "0.1.0",
  "description": "Parse and scrub metadata from images, videos, audio, and documents. The core library for the MetaScrub toolkit at metadatafinder.com.",
  "license": "MIT",
  "homepage": "https://metadatafinder.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/metascrub/metascrub",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "keywords": [
    "metadata",
    "exif",
    "iptc",
    "xmp",
    "gps",
    "privacy",
    "scrub",
    "strip",
    "pdf",
    "docx",
    "image",
    "photo",
    "metadatafinder"
  ],
  "dependencies": {
    "exifr": "^7.1.3",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
