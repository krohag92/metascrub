{
  "name": "n8n-nodes-metascrub",
  "version": "0.1.0",
  "description": "n8n community node for MetaScrub — parse and strip metadata from images, PDFs, DOCX, and more. Powered by metadatafinder.com.",
  "license": "MIT",
  "homepage": "https://metadatafinder.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/metascrub/metascrub",
    "directory": "packages/n8n-node"
  },
  "author": "MetaScrub <hi@metadatafinder.com>",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "metadata",
    "exif",
    "privacy",
    "scrub",
    "strip",
    "metascrub",
    "metadatafinder",
    "image",
    "pdf",
    "docx"
  ],
  "main": "index.js",
  "files": [
    "dist",
    "nodes",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": [
      "dist/nodes/MetaScrub/MetaScrub.node.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "pnpm exec eslint nodes test --max-warnings 0"
  },
  "dependencies": {
    "@metascrub/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "n8n-workflow": "^1.68.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "n8n-workflow": {
      "optional": true
    }
  }
}
