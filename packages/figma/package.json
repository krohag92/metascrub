{
  "name": "@metascrub/figma",
  "version": "0.1.0",
  "description": "MetaScrub Figma plugin — check and strip metadata from images in your designs.",
  "license": "MIT",
  "homepage": "https://metadatafinder.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/metascrub/metascrub",
    "directory": "packages/figma"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@metascrub/core": "workspace:*"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.101.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "figma",
    "plugin",
    "metadata",
    "exif",
    "privacy",
    "metadatafinder"
  ]
}
