<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Group: shared container with the Share Extension -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.metadatafinder.metascrub</string>
    </array>
    <!-- Custom URL scheme registered for deep links from Share Extension -->
    <!-- Register metascrub:// in Info.plist CFBundleURLTypes as well -->
</dict>
</plist>
