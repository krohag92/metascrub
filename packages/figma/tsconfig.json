{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ESNext", "DOM"],
    "types": ["@figma/plugin-typings"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@metascrub/core": ["../core/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
