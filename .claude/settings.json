      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(bunx:*)",
      "Bash(tsc:*)",
      "Bash(tsx:*)",
      "Bash(vitest:*)",
      "Bash(vite:*)",
