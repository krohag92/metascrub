{
  "name": "metascrub-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "MetaScrub — see and strip metadata from any file. Part of metadatafinder.com.",
  "homepage": "https://metadatafinder.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/metascrub/metascrub"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.5",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
