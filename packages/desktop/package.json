    "@tauri-apps/plugin-updater": "^2.9.0",
    "exifr": "^7.1.3",
    "jszip": "^3.10.1",
    "music-metadata": "^11.12.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
