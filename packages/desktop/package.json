  "license": "MIT",
  "homepage": "https://metadatafinder.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/metascrub/metascrub",
    "directory": "packages/desktop"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
